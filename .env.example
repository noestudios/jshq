# Copy to .env (gitignored) and fill in. Backend-only; never exposed to frontend.
# Reminder: .env is NOT in git and NOT in DB backups — back it up manually.
#
# Installed copies keep their .env in the data directory instead
# (~/Library/Application Support/jshq, %LOCALAPPDATA%\jshq, or
# ~/.local/share/jshq); the jshq CLI loads both, cwd first.
#
# You do NOT have to edit this by hand for the key: Settings → System sets it
# (writing it to the data-dir .env). Setting it here still works and, from the
# cwd during dev, takes precedence over the in-app value.
ANTHROPIC_API_KEY=

# Dev-checkout flow: point the app at the repo's data/ dir instead of the
# platform user-data dir. Absolute or ~-relative paths both work.
# JSHQ_DATA_DIR=./data
